{
  "description": "由 devzero 从红线声明编译生成，请勿手改（重新生成会覆盖）。规则：no-push-to-main, no-devzero-state（候选值，Q-T4 待裁决后定格）",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${DEVZERO_HOOKS_ROOT}/redlines/no-push-to-main\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${DEVZERO_HOOKS_ROOT}/redlines/no-devzero-state\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
