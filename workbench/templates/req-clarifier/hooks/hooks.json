{
  "description": "由 devzero 从红线声明编译生成，请勿手改（重新生成会覆盖）。规则：no-devzero-state（已定格，T10 2026-08-27）",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${DEVZERO_HOOKS_ROOT}/redlines/run-hook.cmd\" no-devzero-state.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
