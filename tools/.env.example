# ── Network ───────────────────────────────────────────────────────────
# Browser-accessible IP or DNS hostname (no scheme, no port)
PUBLIC_HOST=127.0.0.1

# ── Database ───────────────────────────────────────────────────────────
# Raw password for PostgreSQL keycloak + platform users
DB_PASSWORD=Horse~test@2026
# URL-encoded version for connection strings (@ -> %40, / -> %2F, etc.)
DB_PASSWORD_URL=Horse~test%402026

# ── Keycloak ───────────────────────────────────────────────────────────
# Bootstrap admin password for Keycloak master realm
KC_ADMIN_PASSWORD=Horse~test@2026

# ── Platform API ──────────────────────────────────────────────────────
# Must match client secrets in iam/realm/digital-employees-realm.json
OIDC_CLIENT_SECRET=platform-dev-secret
IAM_SYNC_CLIENT_SECRET=platform-iam-sync-secret
# Session and token signing (min 32 characters each)
SESSION_SECRET=local-v01-session-secret-change-before-production
MACHINE_SIGNING_SECRET=local-v01-machine-secret-change-before-production

# ── Workbench ──────────────────────────────────────────────────────────
WORKBENCH_STATE_SECRET=local-v01-workbench-state-secret
